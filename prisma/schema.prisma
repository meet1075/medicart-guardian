generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String?   @unique
  name                String?
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  role                String    @default("USER")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  emailVerified       Boolean   @default(false)
  image               String?
  accounts      Account[]
  addresses     Address[]
  orders        Order[]
  sessions      Session[]
}

model Medicine {
  id                   String      @id @default(cuid())
  name                 String
  salt                 String
  brand                String
  mrp                  Float
  packSize             String
  dosageForm           String
  prescriptionRequired Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  inStock              Boolean     @default(true)
  moq                  Int         @default(1)
  category             String      @default("general")
  imageUrl             String?
  orderItems           OrderItem[]
}

model Address {
  id           String   @id @default(cuid())
  fullName     String
  phone        String
  line1        String
  line2        String?
  city         String
  state        String
  pincode      String
  type         String   @default("Home")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  orders       Order[]
}

model Order {
  id                 String             @id @default(cuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  subtotal           Float
  delivery           Float
  total              Float
  hasRx              Boolean            @default(false)
  paymentMethod      String
  status             String             @default("placed")
  prescriptionStatus String?
  reviewedBy         String?
  reviewedAt         DateTime?
  rejectReason       String?
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  shiprocketOrderId  String?
  shipmentId         String?
  awbCode            String?
  courierName        String?
  trackingUrl        String?
  shipmentStatus     String?
  pickupStatus       String?
  isShipmentCreated  Boolean            @default(false)
  shipmentError      String?
  lastShipmentSync   DateTime?
  estimatedDelivery  DateTime?
  userId             String?
  addressId          String
  itemVerifications  ItemVerification[]
  address            Address            @relation(fields: [addressId], references: [id])
  user               User?              @relation(fields: [userId], references: [id])
  items              OrderItem[]
  prescriptionFiles  PrescriptionFile[]
}

model OrderItem {
  id                   String   @id @default(cuid())
  orderId              String
  medicineId           String
  name                 String
  salt                 String?
  dosageForm           String?
  qty                  Int
  price                Float
  prescriptionRequired Boolean  @default(false)
  medicine             Medicine @relation(fields: [medicineId], references: [id])
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PrescriptionFile {
  id                 String @id @default(cuid())
  orderId            String
  name               String
  mimeType           String
  dataUrl            String
  aiExtractionResult Json?
  order              Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ItemVerification {
  id                 String  @id @default(cuid())
  orderId            String
  medicineId         String
  aiStatus           String
  pharmacistApproved Boolean @default(false)
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
